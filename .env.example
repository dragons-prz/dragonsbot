DISCORD_CLIENT_ID=1487313181507588117
DISCORD_TOKEN=coloque_o_token_aqui
DISCORD_GUILD_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# New Relic APM (observabilidade). Opcional em dev: sem NEW_RELIC_LICENSE_KEY o
# agente se desliga sozinho (ver newrelic.js). Em producao, definir no .env da
# VPS (o docker-compose ja carrega via env_file). NUNCA commitar a license key
# nem por no Dockerfile/imagem.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=dragonsbot
NEW_RELIC_LOG=stdout
NEW_RELIC_LOG_LEVEL=info
# NEW_RELIC_LOG_FORWARDING=false   # nao encaminhar logs da app (economiza ingest)

# Log agregado firestore.usage a cada 5min (contagem/latencia por metodo do
# DragonsStore). Independente do New Relic. Defina como "false" para desligar.
# FIRESTORE_USAGE_LOG=false
